    "react-dom": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "lucide-react": "^0.468.0",
    "tailwindcss": "^4.0.0",
    "@langchain/core": "1.3.5",
    "@langchain/openrouter": "0.4.23",
    "@langchain/langgraph": "1.7.2",
    "zod": "4.6.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
