{
  "name": "axiomtech-ai-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:worker && vite build",
    "preview": "vite preview",
    "typecheck:worker": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --lib ES2022,DOM --strict --skipLibCheck worker/index.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "lucide-react": "^0.468.0",
    "tailwindcss": "^4.0.0",
    "@langchain/core": "1.3.5",
    "@langchain/openrouter": "0.4.23",
    "zod": "3.25.76"
  }
}
